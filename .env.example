# Почта для заявок с форм «Заказать звонок» (Resend, https://resend.com).
# На Vercel эти же переменные задаются в Project → Settings → Environment Variables.
RESEND_API_KEY=
# Куда присылать заявки. На тестовом домене Resend письма уходят только на
# адрес владельца аккаунта — впишите его.
MAIL_TO=
# Отправитель. После верификации своего домена: "NORDHAUS <no-reply@nordhaus.ru>".
MAIL_FROM=
